# ====================================================================
# CivicTracker Backend - Supabase Database Configuration
# ====================================================================

# OPTION 1: Supabase Connection String URI (Recommended)
# Locate this in Supabase Dashboard:
# Project Settings -> Database -> Connection string -> URI
# Example with pooling (port 6543) or direct (port 5432):
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# OPTION 2: Individual Connection Variables (Alternative)
# DB_HOST=db.YOUR_PROJECT_REF.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=YOUR_DATABASE_PASSWORD
# DB_NAME=postgres
# DB_SSLMODE=require

# CORS Origins (Use * to allow all origins, or comma-separated URLs like http://localhost:5173,https://yourdomain.com)
CORS_ORIGINS=*

# Server Port (optional, default 8000)
PORT=8000
